---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TagList from "../components/TagList.astro";

// BASE_URL keeps public asset links correct if the site moves to a subpath.
const baseUrl = import.meta.env.BASE_URL;
const resumeUrl = `${baseUrl}resume.pdf`;

const githubUrl = "https://github.com/milsirob";
const portfolioRepositoryUrl =
  "https://github.com/milsirob/devops-portfolio";

const skills = {
  Cloud: [
    "AWS",
    "EC2",
    "S3",
    "IAM",
    "VPC",
    "Route 53",
    "CloudFront",
  ],
  Containers: ["Docker", "Kubernetes", "Helm"],
  Infrastructure: ["Terraform", "CloudFormation", "Linux", "Bash"],
  "CI/CD": ["GitHub Actions", "CircleCI", "Jenkins", "Git", "GitHub"],
  Observability: ["CloudWatch", "Prometheus", "Grafana", "OpenSearch"],
  Development: ["Go", "Python", "YAML", "REST APIs"],
};

const experience = [
  {
    company: "Axios",
    role: "Infrastructure / DevOps Engineer",
    period: "August 2022 – Present",
    technologies:
      "AWS, Kubernetes, Terraform, GitHub Actions, CircleCI, Go",
    achievements: [
      "Managed reusable Terraform infrastructure across multiple production environments, standardizing provisioning and reducing configuration drift.",
      "Built and maintained CI/CD pipelines with GitHub Actions and CircleCI to automate testing and application deployments.",
      "Implemented cross-region infrastructure replication from us-east-1 to us-west-2 to strengthen disaster-recovery readiness.",
    ],
  },
];

const projects = [
  {
    title: "AWS Static Portfolio Platform",
    description:
      "A responsive Astro site deployed through GitHub Actions to S3 and delivered globally through CloudFront.",
    technologies: [
      "Astro",
      "Tailwind CSS",
      "AWS",
      "S3",
      "CloudFront",
      "GitHub Actions",
      "OIDC",
    ],
    repositoryUrl: portfolioRepositoryUrl,
    liveUrl: baseUrl,
  },
  {
    title: "Multi-Environment AWS Platform",
    description:
      "A reusable Terraform architecture for isolated cloud environments, consistent provisioning, and automated infrastructure validation.",
    technologies: ["AWS", "Terraform", "GitHub Actions", "Bash"],
  },
  {
    title: "Kubernetes Delivery Platform",
    description:
      "A container delivery workflow built around Kubernetes, Helm, automated CI checks, and production observability practices.",
    technologies: ["Kubernetes", "Helm", "Docker", "Prometheus"],
  },
];
---

<BaseLayout title="Boris Lim | Infrastructure & DevOps Engineer">
  <Header />

  <main>
    <!-- Hero -->
<section class="portfolio-hero" id="home">
  <div class="portfolio-hero__grid" aria-hidden="true"></div>

  <div class="portfolio-hero__shell">
    <div class="portfolio-hero__content">
      <div class="availability-badge">
        <span class="availability-badge__dot"></span>
        Open to Infrastructure and DevOps opportunities
      </div>

      <div class="identity-command">
        <p class="identity-command__command">
          <span>$</span> whoami
        </p>

        <p class="identity-command__output">Boris Lim</p>
      </div>

      <h1 class="portfolio-hero__title">
        I build reliable
        <span>cloud platforms.</span>
      </h1>

      <p class="portfolio-hero__description">
        I design and operate AWS and Kubernetes platforms, automate
        infrastructure with Terraform, and build delivery pipelines that make
        production releases safer and repeatable.
      </p>

      <div class="portfolio-hero__actions">
        <a class="hero-button hero-button--primary" href="#projects">
          See my work
          <span aria-hidden="true">→</span>
        </a>

        <a
          class="hero-button hero-button--secondary"
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View résumé
        </a>

        <a
          class="hero-button hero-button--secondary"
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="portfolio-hero__highlights">
        <div class="hero-highlight">
          <strong>Cloud</strong>
          <span>AWS and Kubernetes</span>
        </div>

        <div class="hero-highlight">
          <strong>Infrastructure</strong>
          <span>Terraform and automation</span>
        </div>

        <div class="hero-highlight">
          <strong>Delivery</strong>
          <span>Reliable CI/CD pipelines</span>
        </div>
      </div>
    </div>

    <div class="profile-terminal">
      <div class="profile-terminal__topbar">
        <div class="profile-terminal__dots" aria-hidden="true">
          <span class="profile-terminal__dot profile-terminal__dot--red"></span>
          <span
            class="profile-terminal__dot profile-terminal__dot--yellow"
          ></span>
          <span
            class="profile-terminal__dot profile-terminal__dot--green"
          ></span>
        </div>

        <span class="profile-terminal__filename">profile.yaml</span>
      </div>

      <div class="profile-terminal__body">
        <p class="profile-terminal__command">
          <span>$</span>
          cat profile.yaml
        </p>

        <div class="profile-terminal__rows">
          <div class="profile-terminal__row">
            <span class="profile-terminal__key">name:</span>
            <span class="profile-terminal__value">Boris Lim</span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">role:</span>
            <span class="profile-terminal__value">
              Infrastructure / DevOps Engineer
            </span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">cloud:</span>
            <span class="profile-terminal__value">AWS</span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">containers:</span>
            <span class="profile-terminal__value">
              Kubernetes, Docker
            </span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">iac:</span>
            <span class="profile-terminal__value">Terraform</span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">ci_cd:</span>
            <span class="profile-terminal__value">
              GitHub Actions, CircleCI
            </span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">languages:</span>
            <span class="profile-terminal__value">
              Go, Bash, Python
            </span>
          </div>

          <div class="profile-terminal__row">
            <span class="profile-terminal__key">status:</span>
            <span class="profile-terminal__status">
              available
              <span class="profile-terminal__cursor" aria-hidden="true"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- About -->
    <section
      id="about"
      class="border-y border-slate-800 bg-slate-950/50"
    >
      <div class="mx-auto max-w-6xl px-6 py-24">
        <SectionHeading
          number="01"
          label="About"
          title="Building reliable infrastructure through automation"
        />

        <div class="mt-8 grid max-w-5xl gap-8 lg:grid-cols-[1.4fr_1fr]">
          <div class="space-y-5 text-lg leading-8 text-slate-300">
            <p>
              I build and operate cloud infrastructure for production systems,
              with a focus on repeatability, resilience, and developer
              experience.
            </p>

            <p>
              At Axios, I manage AWS and Kubernetes infrastructure, automate
              environments with Terraform, and maintain delivery workflows
              using GitHub Actions and CircleCI.
            </p>

            <p>
              My recent work includes multi-environment infrastructure,
              cross-region disaster-recovery capabilities, and deployment
              automation for Go applications.
            </p>
          </div>

          <dl class="grid grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-5">
              <dt class="text-sm text-slate-400">Primary cloud</dt>
              <dd class="mt-2 text-xl font-bold text-white">AWS</dd>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-5">
              <dt class="text-sm text-slate-400">Infrastructure</dt>
              <dd class="mt-2 text-xl font-bold text-white">Terraform</dd>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-5">
              <dt class="text-sm text-slate-400">Platform</dt>
              <dd class="mt-2 text-xl font-bold text-white">Kubernetes</dd>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-5">
              <dt class="text-sm text-slate-400">Development</dt>
              <dd class="mt-2 text-xl font-bold text-white">Go</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <SectionHeading
          number="02"
          label="Experience"
          title="Professional experience"
        />

        <div class="mt-12 space-y-8">
          {
            experience.map((job) => (
              <article class="rounded-xl border border-slate-800 bg-slate-900/40 p-7">
                <div class="flex flex-col justify-between gap-4 md:flex-row">
                  <div>
                    <h3 class="text-2xl font-bold text-white">{job.role}</h3>

                    <p class="mt-2 text-lg text-cyan-400">
                      {job.company}
                    </p>
                  </div>

                  <p class="font-mono text-sm text-slate-400">
                    {job.period}
                  </p>
                </div>

                <p class="mt-5 font-mono text-sm text-slate-400">
                  {job.technologies}
                </p>

                <ul class="mt-6 space-y-3 text-slate-300">
                  {
                    job.achievements.map((achievement) => (
                      <li class="flex gap-3">
                        <span
                          class="text-cyan-400"
                          aria-hidden="true"
                        >
                          ▹
                        </span>

                        <span>{achievement}</span>
                      </li>
                    ))
                  }
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section
      id="skills"
      class="border-y border-slate-800 bg-slate-950/50"
    >
      <div class="mx-auto max-w-6xl px-6 py-24">
        <SectionHeading
          number="03"
          label="Skills"
          title="Technologies and platforms"
        />

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            Object.entries(skills).map(([category, items]) => (
              <article class="rounded-xl border border-slate-800 bg-slate-900/40 p-6">
                <h3 class="text-xl font-bold text-white">
                  {category}
                </h3>

                <div class="mt-5">
                  <TagList items={items} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <SectionHeading
          number="04"
          label="Projects"
          title="Infrastructure and automation projects"
          description="Selected work demonstrating infrastructure automation, deployment workflows, cloud engineering, and platform operations."
        />

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            projects.map((project) => (
              <ProjectCard {...project} />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section
      id="contact"
      class="border-t border-slate-800 bg-slate-950/50"
    >
      <div class="mx-auto max-w-6xl px-6 py-24 text-center">
        <SectionHeading
          number="05"
          label="Contact"
          title="Let’s discuss infrastructure"
          description="I am open to Infrastructure Engineer, DevOps Engineer, Platform Engineer, and Cloud Engineer opportunities."
          centered
        />

        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <Button
            href="mailto:borislim2@gmail.com"
            variant="primary"
            ariaLabel="Send an email to Boris Lim"
          >
            Contact me
          </Button>

          <Button
            href={githubUrl}
            target="_blank"
            ariaLabel="Open Boris Lim's GitHub profile"
          >
            View GitHub
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /*
   * Prevent invisible decorative layers from blocking links.
   */
  .hero::before,
  .hero::after {
    pointer-events: none;
  }

  .hero-copy,
  .hero-actions {
    position: relative;
    z-index: 2;
  }

  .hero-actions a,
  main a {
    pointer-events: auto;
  }
</style>
