---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const skills = {
  Cloud: ["AWS", "EC2", "S3", "IAM", "VPC", "Route 53", "CloudFront", "EKS"],
  Containers: ["Docker", "Kubernetes", "Helm"],
  Infrastructure: ["Terraform", "CloudFormation", "Linux", "Bash"],
  CICD: ["GitHub Actions", "Jenkins", "Git", "GitHub"],
  Observability: ["CloudWatch", "Prometheus", "Grafana", "OpenSearch"],
  Development: ["Go", "Python", "YAML", "REST APIs"],
};

const experience = [
  {
    company: "Axios",
    role: "Infrastructure / DevOps Engineer",
    period: "Aug 2022 – Present",
    technologies: "AWS, Kubernetes, Terraform, GitHub Actions, Go",
    achievements: [
      "Managed Terraform infrastructure across environments, reducing provisioning time.",
      "Built scalable CI/CD pipelines with GitHub Actions and CircleCI for automated testing and deployments.",
      "Implemented cross-region infrastructure replication from us-east-1 to us-west-2 for full disaster recovery.",
    ],
  },
];
---

<BaseLayout title="Boris Lim | Infrastructure & DevOps Engineer">
  <Header />

  <main>
    <section class="mx-auto flex min-h-[88vh] max-w-6xl items-center px-6 py-20">
      <div class="max-w-5xl">
        <p class="mb-5 font-mono text-lg text-cyan-400">
          $ whoami
        </p>

        <h1 class="text-5xl font-bold tracking-tight text-white md:text-7xl">
          Infrastructure and
          <span class="block text-cyan-400">DevOps Engineer</span>
        </h1>

        <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-300">
          I design, automate and operate cloud infrastructure using AWS,
          Kubernetes, Terraform, GitHub Actions and Go.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="rounded-lg bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            View projects
          </a>

          <a
            href="/resume.pdf"
            class="rounded-lg border border-slate-600 px-6 py-3 font-semibold text-white transition hover:border-cyan-400 hover:text-cyan-400"
          >
            Download résumé
          </a>

          <a
            href="https://github.com/borislim2"
            target="_blank"
            rel="noreferrer"
            class="rounded-lg border border-slate-600 px-6 py-3 font-semibold text-white transition hover:border-cyan-400 hover:text-cyan-400"
          >
            GitHub
          </a>
        </div>

        <div class="mt-14 overflow-hidden rounded-xl border border-slate-800 bg-slate-950 shadow-2xl">
          <div class="flex items-center gap-2 border-b border-slate-800 px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-red-400"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
            <span class="h-3 w-3 rounded-full bg-green-400"></span>
          </div>

          <div class="space-y-3 p-6 font-mono text-sm md:text-base">
            <p><span class="text-cyan-400">$</span> cat profile.yaml</p>
            <p class="text-slate-400">role: Infrastructure / DevOps Engineer</p>
            <p class="text-slate-400">cloud: AWS</p>
            <p class="text-slate-400">containers: Kubernetes, Docker</p>
            <p class="text-slate-400">iac: Terraform</p>
            <p class="text-slate-400">cicd: GitHub Actions</p>
            <p class="text-slate-400">languages: Go, Bash, Python</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="border-y border-slate-800 bg-slate-950/50">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <p class="font-mono text-cyan-400">01. About</p>

        <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
          Building reliable infrastructure through automation
        </h2>

        <div class="mt-8 max-w-4xl space-y-5 text-lg leading-8 text-slate-300">
          <p>
            I am an Infrastructure and DevOps Engineer with experience supporting
            cloud infrastructure, Kubernetes environments, CI/CD systems and
            source-control workflows.
          </p>

          <p>
            My work focuses on AWS, Kubernetes, Terraform, GitHub and production
            applications written primarily in Go.
          </p>

          <p>
            Replace these paragraphs with your actual professional background,
            years of experience, industries and major areas of responsibility.
          </p>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <p class="font-mono text-cyan-400">02. Experience</p>

        <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
          Professional experience
        </h2>

        <div class="mt-12 space-y-8">
          {
            experience.map((job) => (
              <article class="rounded-xl border border-slate-800 bg-slate-900/40 p-7">
                <div class="flex flex-col justify-between gap-4 md:flex-row">
                  <div>
                    <h3 class="text-2xl font-bold text-white">{job.role}</h3>
                    <p class="mt-2 text-lg text-cyan-400">{job.company}</p>
                  </div>

                  <p class="font-mono text-sm text-slate-400">{job.period}</p>
                </div>

                <p class="mt-5 font-mono text-sm text-slate-400">
                  {job.technologies}
                </p>

                <ul class="mt-6 space-y-3 text-slate-300">
                  {
                    job.achievements.map((achievement) => (
                      <li class="flex gap-3">
                        <span class="text-cyan-400">▹</span>
                        <span>{achievement}</span>
                      </li>
                    ))
                  }
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="skills" class="border-y border-slate-800 bg-slate-950/50">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <p class="font-mono text-cyan-400">03. Skills</p>

        <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
          Technologies and platforms
        </h2>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            Object.entries(skills).map(([category, items]) => (
              <article class="rounded-xl border border-slate-800 bg-slate-900/40 p-6">
                <h3 class="text-xl font-bold text-white">{category}</h3>

                <div class="mt-5 flex flex-wrap gap-2">
                  {
                    items.map((item) => (
                      <span class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-slate-300">
                        {item}
                      </span>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="mx-auto max-w-6xl px-6 py-24 text-center">
        <p class="font-mono text-cyan-400">04. Contact</p>

        <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
          Let’s discuss infrastructure
        </h2>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300">
          I am open to Infrastructure Engineer, DevOps Engineer, Platform
          Engineer and Cloud Engineer opportunities.
        </p>

        <a
          href="mailto:borislim2@gmail.com"
          class="mt-9 inline-block rounded-lg bg-cyan-400 px-7 py-3 font-semibold text-slate-950 hover:bg-cyan-300"
        >
          Contact me
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
