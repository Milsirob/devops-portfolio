---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Technologies used">
  {
    items.map((item) => (
      <li class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-slate-300">
        {item}
      </li>
    ))
  }
</ul>
