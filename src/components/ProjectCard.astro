---
import Button from "./Button.astro";
import TagList from "./TagList.astro";

interface Props {
  title: string;
  description: string;
  technologies: string[];
  repositoryUrl?: string;
  liveUrl?: string;
}

const { title, description, technologies, repositoryUrl, liveUrl } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-xl border border-slate-800 bg-slate-900/40 p-7 transition duration-200 hover:-translate-y-1 hover:border-slate-700 hover:bg-slate-900/60"
>
  <h3 class="text-2xl font-bold text-white">{title}</h3>
  <p class="mt-4 flex-1 leading-7 text-slate-300">{description}</p>

  <div class="mt-6">
    <TagList items={technologies} />
  </div>

  {
    (repositoryUrl || liveUrl) && (
      <div class="mt-7 flex flex-wrap gap-3">
        {repositoryUrl && (
          <Button
            href={repositoryUrl}
            variant="primary"
            target="_blank"
            ariaLabel={`View ${title} source code on GitHub`}
          >
            View source
          </Button>
        )}
        {liveUrl && (
          <Button href={liveUrl} ariaLabel={`View ${title}`}>
            View live site
          </Button>
        )}
      </div>
    )
  }
</article>
